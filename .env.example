PORT=8088

# MongoDB connection string for contact submissions.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Gmail account and a 16-character Google App Password.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-google-app-password

# Twilio credentials and E.164 phone numbers for SMS notifications.
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your-twilio-auth-token
TWILIO_FROM=+15551234567
OWNER_PHONE=+919876543210
